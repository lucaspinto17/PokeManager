#!/usr/bin/env sh
# Lightweight Maven bootstrap wrapper (POSIX)
# Downloads Apache Maven 3.9.6 into .mvn/apache-maven-3.9.6 if needed and runs it.

MAVEN_VERSION=3.9.6
MAVEN_DIR=".mvn/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_DIR/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  echo "Maven not found locally. Downloading Apache Maven $MAVEN_VERSION..."
  mkdir -p .mvn
  ZIPFILE=.mvn/maven.zip
  if [ ! -f "$ZIPFILE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -L -o "$ZIPFILE" "https://downloads.apache.org/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.zip"
    elif command -v wget >/dev/null 2>&1; then
      wget -O "$ZIPFILE" "https://downloads.apache.org/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.zip"
    else
      echo "curl or wget required to download Maven. Install one or install Maven manually." >&2
      exit 1
    fi
  fi
  if command -v unzip >/dev/null 2>&1; then
    unzip -q "$ZIPFILE" -d .mvn || { echo "Failed to unzip Maven" >&2; exit 1; }
  else
    echo "unzip required to extract Maven. Install it or extract manually." >&2
    exit 1
  fi
  rm -f "$ZIPFILE"
fi

exec "$MAVEN_BIN" "$@"
